# ─── Telegram ────────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ─── AI Providers (priority: Gemini → DeepSeek → Claude) ─────────────────────
# At least one key is required. The agent tries each in order and falls back.

# 1. Gemini — free tier generous, recommended primary
#    https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# 2. DeepSeek — cheap, OpenAI-compatible API
#    https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# 3. Claude — best at document reasoning, costs more
#    https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-6

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Gmail: use an App Password (not your real password)
#   https://myaccount.google.com/apppasswords
# Outlook: smtp-mail.outlook.com, port 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=you@gmail.com
FROM_NAME=Your Full Name

# ─── App ─────────────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000
DATA_DIR=./data
UPLOADS_DIR=./uploads

# Dashboard password — leave blank for local use, required when deploying online
# Access the dashboard with any username + this value as the password
DASHBOARD_TOKEN=
